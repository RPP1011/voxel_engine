#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Input: binary voxel grid (R8_UINT 3D)
layout(set = 0, binding = 0) uniform usampler3D voxel_grid;

// Output: seed buffer (RGBA32I) — xyz = nearest seed coords, w = occupied flag
layout(set = 0, binding = 1, rgba32i) uniform writeonly iimage3D seed_buf;

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
    uint voxel = texelFetch(voxel_grid, pos, 0).r;

    if (voxel != 0u) {
        // Surface/occupied voxel: seed is itself
        imageStore(seed_buf, pos, ivec4(pos, 1));
    } else {
        // Empty: no seed (sentinel)
        imageStore(seed_buf, pos, ivec4(-1, -1, -1, 0));
    }
}
