#version 450

// Helpers inlined (would be terrain_common.glsl but build.rs doesn't configure includes).
// Mirrors src/world_sim/terrain/noise.rs::hash_u32 byte-for-byte.

uint hash_u32(int x, int y, int z, uint seed) {
    uint h = seed + 0x9e3779b9u;
    h = (h + uint(x)) * 0x9e3779b9u;
    h = (h + uint(y)) * 0x85ebca6bu;
    h = (h + uint(z)) * 0xc2b2ae35u;
    // Murmur3 fmix32 finalizer
    h ^= h >> 16;
    h = h * 0x85ebca6bu;
    h ^= h >> 13;
    h = h * 0xc2b2ae35u;
    h ^= h >> 16;
    return h;
}

float hash_f32(int x, int y, int z, uint seed) {
    return float(hash_u32(x, y, z, seed)) / 4294967295.0;
}

// --- 64-bit arithmetic helpers for hash_3d (u64 path) -----------------------
// Mirrors Rust noise.rs::hash_3d which uses u64 arithmetic. We emulate u64
// as uvec2(hi, lo). Needed because materialize.rs calls noise::hash_f32
// (the u64-based hash_3d), not the u32 Murmur3 path used by fbm_2d.

uvec2 u64_add(uvec2 a, uvec2 b) {
    uint lo = a.y + b.y;
    uint carry = (lo < a.y) ? 1u : 0u;
    uint hi = a.x + b.x + carry;
    return uvec2(hi, lo);
}

// Low 64 bits of (a * b). Uses umulExtended for 32x32->64 partial products.
uvec2 u64_mul(uvec2 a, uvec2 b) {
    uint ll_hi, ll_lo;
    umulExtended(a.y, b.y, ll_hi, ll_lo);  // a_lo * b_lo (full 64)
    uint lh_lo = a.y * b.x;                 // low(a_lo * b_hi)
    uint hl_lo = a.x * b.y;                 // low(a_hi * b_lo)
    uint out_lo = ll_lo;
    uint out_hi = ll_hi + lh_lo + hl_lo;
    return uvec2(out_hi, out_lo);
}

// Logical shift right by 33 (only case used in hash_3d).
uvec2 u64_shr33(uvec2 a) {
    return uvec2(0u, a.x >> 1u);
}

uvec2 u64_xor(uvec2 a, uvec2 b) {
    return uvec2(a.x ^ b.x, a.y ^ b.y);
}

// Sign-extend i32 to u64 (matches Rust `x as u64` for signed x).
uvec2 i32_to_u64(int x) {
    uint lo = uint(x);
    uint hi = (x < 0) ? 0xFFFFFFFFu : 0u;
    return uvec2(hi, lo);
}

// Mirrors Rust noise.rs::hash_3d. Multiplier 0x5851F42D4C957F2D,
// fmix constant 0xFF51AFD7ED558CCD. Returns high 32 bits (h >> 32 as u32).
uint hash_3d_u64(int x, int y, int z, uvec2 seed) {
    const uvec2 K1 = uvec2(0x5851F42Du, 0x4C957F2Du);
    const uvec2 K2 = uvec2(0xFF51AFD7u, 0xED558CCDu);
    uvec2 h = seed;
    h = u64_add(u64_mul(h, K1), i32_to_u64(x));
    h = u64_add(u64_mul(h, K1), i32_to_u64(y));
    h = u64_add(u64_mul(h, K1), i32_to_u64(z));
    h = u64_xor(h, u64_shr33(h));
    h = u64_mul(h, K2);
    h = u64_xor(h, u64_shr33(h));
    return h.x; // (h >> 32) as u32
}

// Mirrors Rust noise.rs::hash_f32 (the u64-seed version). Called from
// materialize.rs for ore veins and surface variation. The `seed` parameter
// is a u32; we zero-extend to u64 (since the parity test seed fits in u32).
float hash_f32_u64(int x, int y, int z, uint seed) {
    uvec2 s = uvec2(0u, seed);
    return float(hash_3d_u64(x, y, z, s)) / 4294967295.0;
}

// Widen a u32 seed to u64 as uvec2(hi=0, lo=seed).
uvec2 widen_seed(uint seed) {
    return uvec2(0u, seed);
}

// hash_f32_u64 with a u64 seed expressed as uvec2(hi, lo).
float hash_f32_u64_full(int x, int y, int z, uvec2 seed) {
    return float(hash_3d_u64(x, y, z, seed)) / 4294967295.0;
}

float smoothstep_t(float t) {
    return t * t * (3.0 - 2.0 * t);
}

// Mirrors Rust noise.rs::value_noise_3d. Uses the u32 hash path with the same
// s32 = seed_lo ^ seed_hi fold. Callers pass an already-folded u32 seed.
float value_noise_3d(float x, float y, float z, uint seed, float scale) {
    float sx = x / scale;
    float sy = y / scale;
    float sz = z / scale;
    int ix = int(floor(sx));
    int iy = int(floor(sy));
    int iz = int(floor(sz));
    float fx = smoothstep_t(sx - floor(sx));
    float fy = smoothstep_t(sy - floor(sy));
    float fz = smoothstep_t(sz - floor(sz));
    float c000 = hash_f32(ix,     iy,     iz,     seed);
    float c100 = hash_f32(ix + 1, iy,     iz,     seed);
    float c010 = hash_f32(ix,     iy + 1, iz,     seed);
    float c110 = hash_f32(ix + 1, iy + 1, iz,     seed);
    float c001 = hash_f32(ix,     iy,     iz + 1, seed);
    float c101 = hash_f32(ix + 1, iy,     iz + 1, seed);
    float c011 = hash_f32(ix,     iy + 1, iz + 1, seed);
    float c111 = hash_f32(ix + 1, iy + 1, iz + 1, seed);
    float a0 = c000 + (c100 - c000) * fx;
    float b0 = c010 + (c110 - c010) * fx;
    float a1 = c001 + (c101 - c001) * fx;
    float b1 = c011 + (c111 - c011) * fx;
    float c0 = a0 + (b0 - a0) * fy;
    float c1 = a1 + (b1 - a1) * fy;
    return c0 + (c1 - c0) * fz;
}

// Mirrors Rust value_noise_2d (with the s32 fold).
float value_noise_2d(float x, float y, uint seed, float scale) {
    float sx = x / scale;
    float sy = y / scale;
    int ix = int(floor(sx));
    int iy = int(floor(sy));
    float fx = smoothstep_t(sx - floor(sx));
    float fy = smoothstep_t(sy - floor(sy));
    float h00 = hash_f32(ix,     iy,     0, seed);
    float h10 = hash_f32(ix + 1, iy,     0, seed);
    float h01 = hash_f32(ix,     iy + 1, 0, seed);
    float h11 = hash_f32(ix + 1, iy + 1, 0, seed);
    float a = h00 + (h10 - h00) * fx;
    float b = h01 + (h11 - h01) * fx;
    return a + (b - a) * fy;
}

// Mirrors Rust fbm_2d. Note the per-octave seed offset matches Rust: seed + i*31337.
float fbm_2d(float x, float y, uint seed, int octaves, float lacunarity, float gain) {
    float sum = 0.0;
    float amp = 1.0;
    float freq = 1.0;
    float max_amp = 0.0;
    for (int i = 0; i < octaves; i++) {
        sum += amp * value_noise_2d(x * freq, y * freq, seed + uint(i * 31337), 1.0);
        max_amp += amp;
        amp *= gain;
        freq *= lacunarity;
    }
    return sum / max_amp;
}

// Region plan structures — must match Rust RegionCellGpu / RegionPlanHeader
// byte-for-byte (std430). 32 bytes per cell, 16 bytes for header.
struct RegionCell {
    float height;
    float moisture;
    float temperature;
    uint terrain;
    uint sub_biome;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

layout(set = 0, binding = 1) readonly buffer RegionCellsBuf {
    RegionCell cells[];
} region;

layout(set = 0, binding = 2) readonly buffer RegionHeaderBuf {
    uint cols;
    uint rows;
    uint cell_size;
    uint _pad;
} header;

// River polylines — std430 layout, must match Rust RiverPointGpu / RiverHeaderGpu.
struct RiverPoint {
    float x;
    float y;
    float width;
    float _pad;
};

struct RiverHeader {
    uint start_idx;
    uint count;
    uint _pad0;
    uint _pad1;
};

layout(set = 0, binding = 3) readonly buffer RiverPointsBuf {
    RiverPoint points[];
} river_points;

layout(set = 0, binding = 4) readonly buffer RiverHeadersBuf {
    RiverHeader headers[];
} river_headers;

// Sample the nearest region cell for a voxel (vx, vy) position.
RegionCell sample_cell(float vx, float vy) {
    int col = clamp(int(floor(vx / float(header.cell_size))), 0, int(header.cols) - 1);
    int row = clamp(int(floor(vy / float(header.cell_size))), 0, int(header.rows) - 1);
    return region.cells[row * int(header.cols) + col];
}

// Bilinear interpolation of region cell height at (vx, vy).
// Mirrors Rust RegionPlan::interpolate_height.
float interpolate_height(float vx, float vy) {
    float cs = float(header.cell_size);
    float cx = vx / cs;
    float cy = vy / cs;
    int col0 = clamp(int(floor(cx)), 0, int(header.cols) - 1);
    int row0 = clamp(int(floor(cy)), 0, int(header.rows) - 1);
    int col1 = min(col0 + 1, int(header.cols) - 1);
    int row1 = min(row0 + 1, int(header.rows) - 1);
    float tx = cx - floor(cx);
    float ty = cy - floor(cy);
    float h00 = region.cells[row0 * int(header.cols) + col0].height;
    float h10 = region.cells[row0 * int(header.cols) + col1].height;
    float h01 = region.cells[row1 * int(header.cols) + col0].height;
    float h11 = region.cells[row1 * int(header.cols) + col1].height;
    float h0 = h00 + (h10 - h00) * tx;
    float h1 = h01 + (h11 - h01) * tx;
    return h0 + (h1 - h0) * ty;
}

// Biome-aware surface height. Terrain enum mapping must match
// src/world_sim/state.rs::Terrain::to_u32:
//   0=Plains 1=Forest 2=Mountains 3=Coast 4=Swamp 5=Desert 6=Tundra
//   7=Volcano 8=DeepOcean 9=Jungle 10=Glacier 11=Caverns 12=Badlands
//   13=FlyingIslands 14=DeathZone 15=AncientRuins 16=CoralReef
int surface_height_at(float vx, float vy, uint seed) {
    float base_height = interpolate_height(vx, vy);
    RegionCell cell = sample_cell(vx, vy);
    uint terrain = cell.terrain;

    // Per-octave seed offsets must match Rust materialize.rs::surface_height_at:
    // 0xface_cafe, 0xdead_beef, 0xcafe_babe.
    float large = fbm_2d(vx * 0.004, vy * 0.004, seed + 0xfacecafeu, 4, 2.0, 0.5);
    float medium = fbm_2d(vx * 0.015, vy * 0.015, seed + 0xdeadbeefu, 3, 2.0, 0.5);
    float small = fbm_2d(vx * 0.06, vy * 0.06, seed + 0xcafebabeu, 2, 2.0, 0.5);

    // Default (matches the `_` arm in Rust: (25.0, 10.0, 3.0)).
    float large_amp = 25.0;
    float medium_amp = 10.0;
    float small_amp = 3.0;

    if (terrain == 2u || terrain == 10u) {        // Mountains | Glacier
        large_amp = 80.0; medium_amp = 30.0; small_amp = 5.0;
    } else if (terrain == 7u) {                   // Volcano
        large_amp = 60.0; medium_amp = 25.0; small_amp = 4.0;
    } else if (terrain == 12u) {                  // Badlands
        large_amp = 50.0; medium_amp = 35.0; small_amp = 10.0;
    } else if (terrain == 1u) {                   // Forest
        large_amp = 30.0; medium_amp = 12.0; small_amp = 3.0;
    } else if (terrain == 9u) {                   // Jungle
        large_amp = 45.0; medium_amp = 20.0; small_amp = 6.0;
    } else if (terrain == 6u) {                   // Tundra
        large_amp = 25.0; medium_amp = 10.0; small_amp = 2.0;
    } else if (terrain == 5u) {                   // Desert
        large_amp = 35.0; medium_amp = 20.0; small_amp = 4.0;
    } else if (terrain == 4u || terrain == 3u) {  // Swamp | Coast
        large_amp = 5.0; medium_amp = 3.0; small_amp = 1.0;
    } else if (terrain == 8u || terrain == 16u) { // DeepOcean | CoralReef
        large_amp = 10.0; medium_amp = 5.0; small_amp = 1.0;
    }

    float detail = (large * 2.0 - 1.0) * large_amp
                 + (medium * 2.0 - 1.0) * medium_amp
                 + (small * 2.0 - 1.0) * small_amp;

    const int MAX_SURFACE_Z = 2000;
    return int(round(base_height * float(MAX_SURFACE_Z) + detail));
}

// One invocation per voxel. With cs=64, 8x8x8 groups = 8 workgroups per axis.
// Local size: 8 × 8 × 8 = 512.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Output: 3D R8_UINT storage image, one material per voxel. Stays resident on
// GPU so the renderer can sample it directly without a readback roundtrip.
layout(set = 0, binding = 0, r8ui) uniform writeonly uimage3D out_image;

layout(push_constant) uniform PushConstants {
    ivec4 chunk_pos;       // (cx, cy, cz, _)
    uvec4 params;          // (seed, chunk_size, _, _)
} pc;

const uint MAT_AIR     = 0u;
const uint MAT_DIRT    = 1u;
const uint MAT_STONE   = 2u;
const uint MAT_GRANITE = 3u;
const uint MAT_GRASS   = 7u;

const int SEA_LEVEL = 350;

// Returns (surface_mat, subsoil_mat, deep_stone_mat) packed into uvec3.
// Mirrors Rust biome.rs::surface_materials.
uvec3 surface_materials(uint terrain) {
    if (terrain == 0u)  return uvec3(41u, 1u, 2u);   // Plains: TallGrass, Dirt, Stone
    if (terrain == 1u)  return uvec3(7u, 1u, 2u);    // Forest: Grass, Dirt, Stone
    if (terrain == 9u)  return uvec3(37u, 5u, 2u);   // Jungle: JungleMoss, Clay, Stone
    if (terrain == 5u)  return uvec3(4u, 27u, 2u);   // Desert: Sand, Sandstone, Stone
    if (terrain == 12u) return uvec3(39u, 27u, 3u);  // Badlands: RedSand, Sandstone, Granite
    if (terrain == 2u)  return uvec3(2u, 2u, 3u);    // Mountains: Stone, Stone, Granite
    if (terrain == 6u)  return uvec3(40u, 6u, 2u);   // Tundra: Peat, Gravel, Stone
    if (terrain == 10u) return uvec3(11u, 10u, 2u);  // Glacier: Snow, Ice, Stone
    if (terrain == 4u)  return uvec3(38u, 5u, 2u);   // Swamp: MudGrass, Clay, Stone
    if (terrain == 3u)  return uvec3(4u, 4u, 2u);    // Coast: Sand, Sand, Stone
    if (terrain == 16u) return uvec3(4u, 4u, 2u);    // CoralReef: Sand, Sand, Stone
    if (terrain == 7u)  return uvec3(26u, 26u, 36u); // Volcano: Basalt, Basalt, Obsidian
    if (terrain == 11u) return uvec3(2u, 2u, 2u);    // Caverns: Stone, Stone, Stone
    if (terrain == 8u)  return uvec3(4u, 5u, 2u);    // DeepOcean: Sand, Clay, Stone
    if (terrain == 14u) return uvec3(29u, 1u, 2u);   // DeathZone: Bone, Dirt, Stone
    if (terrain == 15u) return uvec3(7u, 31u, 2u);   // AncientRuins: Grass, CutStone, Stone
    if (terrain == 13u) return uvec3(7u, 1u, 2u);    // FlyingIslands: Grass, Dirt, Stone
    return uvec3(2u, 1u, 2u); // default
}

// Returns ore material (12=IronOre, 13=CopperOre, 14=GoldOre, 15=Coal, 16=Crystal),
// or 0 if no ore at this position. Mirrors Rust materialize.rs::ore_at.
uint ore_at(int vx, int vy, int vz, uint seed, float ore_boost) {
    float n = hash_f32_u64(vx, vy, vz, seed + 0x0EE1u);
    float threshold_base = 0.92 - ore_boost;
    float copper_base    = 0.88 - ore_boost;
    float crystal_base   = 0.95 - ore_boost;

    if (n > threshold_base) {
        if (vz < 8) return 14u;        // GoldOre
        else if (vz < 12) return 12u;  // IronOre
        else return 15u;               // Coal
    } else if (n > copper_base && vz < 10) {
        return 13u; // CopperOre
    } else if (n > crystal_base && vz < 6) {
        return 16u; // Crystal
    }
    return 0u; // no ore
}

// ---------------------------------------------------------------------------
// Cave carving — mirrors Rust terrain/caves.rs + biome.rs::resolve_biome.
// ---------------------------------------------------------------------------
//
// SubBiome discriminants — must match src/world_sim/state.rs::SubBiome::to_u32.
const uint SUB_STANDARD       = 0u;
const uint SUB_LIGHT_FOREST   = 1u;
const uint SUB_DENSE_FOREST   = 2u;
const uint SUB_ANCIENT_FOREST = 3u;
const uint SUB_TEMPLE_JUNGLE  = 8u;
const uint SUB_NATURAL_CAVE   = 9u;
const uint SUB_LAVA_TUBES     = 10u;
const uint SUB_FROZEN_CAVERN  = 11u;
const uint SUB_MUSHROOM_GROVE = 12u;
const uint SUB_CRYSTAL_VEIN   = 13u;
const uint SUB_AQUIFER        = 14u;
const uint SUB_BONE_OSSUARY   = 15u;

// Material ids referenced by cave fills. Matches VoxelMaterial enum repr.
const uint MAT_WATER = 8u;
const uint MAT_LAVA  = 9u;
const uint MAT_ICE   = 10u;

// vec4(scale, threshold, fill_id, floor_fill_id). floor_fill_id = 255 means
// "no floor fill". threshold = 0 means "non-cave biome, do not carve".
// Mirrors Rust caves.rs::cave_params.
vec4 cave_params(uint sub_biome) {
    if (sub_biome == SUB_NATURAL_CAVE)   return vec4(16.0, 0.06, float(MAT_AIR),   255.0);
    if (sub_biome == SUB_LAVA_TUBES)     return vec4(24.0, 0.07, float(MAT_AIR),   float(MAT_LAVA));
    if (sub_biome == SUB_MUSHROOM_GROVE) return vec4(32.0, 0.09, float(MAT_AIR),   255.0);
    if (sub_biome == SUB_CRYSTAL_VEIN)   return vec4(10.0, 0.04, float(MAT_AIR),   255.0);
    if (sub_biome == SUB_AQUIFER)        return vec4(20.0, 0.07, float(MAT_WATER), 255.0);
    if (sub_biome == SUB_FROZEN_CAVERN)  return vec4(20.0, 0.06, float(MAT_AIR),   float(MAT_ICE));
    if (sub_biome == SUB_BONE_OSSUARY)   return vec4(18.0, 0.06, float(MAT_AIR),   255.0);
    return vec4(16.0, 0.0, float(MAT_AIR), 255.0); // threshold=0 → no carving
}

// Port of Rust biome.rs::resolve_biome — UNDERGROUND variant only.
//
// CAVEAT: faithful port of a pre-existing sign-convention bug. The doc
// says "positive = above surface, negative = underground" but materialize.rs
// calls this with `surface_z - cz` which is POSITIVE when underground. The
// first arm `>= -40` then catches all positive depths. Effect on CPU: only
// Caverns-surface chunks ever carve (via the first branch). The deeper
// branches are dead code in practice. Ported AS-IS for GPU/CPU parity;
// fixing the bug is a separate task.
uint resolve_underground_biome(uint surface_terrain, int depth_below_surface) {
    if (depth_below_surface >= -40) {
        // Near-surface — only Caverns (id=11) gets a real cave.
        if (surface_terrain == 11u) return SUB_NATURAL_CAVE;
        return SUB_STANDARD;
    } else if (depth_below_surface >= -250) {
        if (surface_terrain == 7u)  return SUB_LAVA_TUBES;     // Volcano
        if (surface_terrain == 2u)  return SUB_NATURAL_CAVE;    // Mountains
        if (surface_terrain == 6u || surface_terrain == 10u) return SUB_FROZEN_CAVERN; // Tundra/Glacier
        if (surface_terrain == 1u || surface_terrain == 9u)  return SUB_MUSHROOM_GROVE; // Forest/Jungle
        if (surface_terrain == 4u || surface_terrain == 3u)  return SUB_AQUIFER;        // Swamp/Coast
        if (surface_terrain == 14u || surface_terrain == 15u) return SUB_BONE_OSSUARY;  // DeathZone/AncientRuins
        if (surface_terrain == 11u) return SUB_CRYSTAL_VEIN;   // Caverns
        return SUB_NATURAL_CAVE;
    } else if (depth_below_surface >= -350) {
        if (surface_terrain == 7u)  return SUB_LAVA_TUBES;
        if (surface_terrain == 6u || surface_terrain == 10u) return SUB_FROZEN_CAVERN;
        return SUB_NATURAL_CAVE;
    } else {
        return SUB_LAVA_TUBES;
    }
}

// Cave seeds: port of Rust u64 seed.wrapping_add(0xCAFE_BABE_0001) folded
// to u32 via (hi ^ lo). Uses uaddCarry to handle the (rare) overflow case.
// 0xCAFE_BABE_0001 = hi 0x0000CAFE, lo 0xBABE0001.
// 0xDEAD_BEEF_0002 = hi 0x0000DEAD, lo 0xBEEF0002.
uint cave_seed_a(uint seed) {
    uint carry;
    uint sum_lo = uaddCarry(seed, 0xBABE0001u, carry);
    uint sum_hi = 0x0000CAFEu + carry;
    return sum_lo ^ sum_hi;
}
uint cave_seed_b(uint seed) {
    uint carry;
    uint sum_lo = uaddCarry(seed, 0xBEEF0002u, carry);
    uint sum_hi = 0x0000DEADu + carry;
    return sum_lo ^ sum_hi;
}

// Worm cave test — both fields must be within `threshold` of 0.5.
// Mirrors Rust caves.rs: pre-divides by scale then calls value_noise_3d
// with scale=1.0 so the 3D lattice spacing matches the CPU.
bool is_cave(int vx, int vy, int vz, uint seed_a, uint seed_b, float scale, float threshold) {
    float fx = float(vx) / scale;
    float fy = float(vy) / scale;
    float fz = float(vz) / scale;
    float a = value_noise_3d(fx, fy, fz, seed_a, 1.0);
    float b = value_noise_3d(fx, fy, fz, seed_b, 1.0);
    return abs(a - 0.5) < threshold && abs(b - 0.5) < threshold;
}

// Returns the cave override material for (vx,vy,vz), or 0xFFFFFFFFu if no
// carving should happen. Caller must check base_mat solidity first.
// `lz` is the voxel's chunk-local z; used for the "bottom of chunk → floor"
// rule matching Rust caves.rs.
uint cave_override(int vx, int vy, int vz, int lz, uint base_mat,
                   uint seed, vec4 params) {
    float scale     = params.x;
    float threshold = params.y;
    uint  fill_id   = uint(params.z);
    uint  floor_id  = uint(params.w);

    // Skip non-solid and Granite (matches Rust: !mat.is_solid() || mat == Granite).
    // is_solid returns false for Air, Water, Lava — we test for those directly.
    if (base_mat == MAT_AIR || base_mat == MAT_WATER || base_mat == MAT_LAVA
        || base_mat == MAT_GRANITE) {
        return 0xFFFFFFFFu;
    }
    if (threshold == 0.0) return 0xFFFFFFFFu;

    uint seed_a = cave_seed_a(seed);
    uint seed_b = cave_seed_b(seed);
    if (!is_cave(vx, vy, vz, seed_a, seed_b, scale, threshold)) {
        return 0xFFFFFFFFu;
    }

    // Has a floor fill? Decide if this is a "floor" voxel.
    if (floor_id != 255u) {
        bool is_floor;
        if (lz == 0) {
            // Bottom of chunk — Rust treats this as floor unconditionally.
            is_floor = true;
        } else {
            // Rust also checks that the voxel below is carvable solid (not
            // air/water/lava/granite) BEFORE running the noise test. Without
            // chunk-wide base material state we approximate: assume the
            // below voxel is solid (worst case — produces a tiny floor
            // over-fill compared to CPU when the voxel below is already
            // water/lava/air, e.g. at ore veins or air pockets).
            bool below_is_cave = is_cave(vx, vy, vz - 1, seed_a, seed_b, scale, threshold);
            is_floor = !below_is_cave;
        }
        if (is_floor) return floor_id;
    }
    return fill_id;
}

// ---------------------------------------------------------------------------
// River carving — mirrors Rust terrain/rivers.rs.
// ---------------------------------------------------------------------------

float segment_closest_t(float px, float py, float ax, float ay, float bx, float by) {
    float dx = bx - ax;
    float dy = by - ay;
    float len2 = dx * dx + dy * dy;
    if (len2 < 1e-6) return 0.0;
    return ((px - ax) * dx + (py - ay) * dy) / len2;
}

// Walk all river polylines and return vec2(closest_dist, interpolated_width)
// for the nearest segment to (px, py). Returns dist=1e10 if no rivers.
vec2 closest_river_distance(float px, float py) {
    float best_dist = 1e10;
    float best_width = 1.0;
    uint n_rivers = river_headers.headers.length();
    for (uint r = 0u; r < n_rivers; r++) {
        RiverHeader hdr = river_headers.headers[r];
        if (hdr.count < 2u) continue;
        uint segs = hdr.count - 1u;
        for (uint i = 0u; i < segs; i++) {
            RiverPoint a = river_points.points[hdr.start_idx + i];
            RiverPoint b = river_points.points[hdr.start_idx + i + 1u];
            float t = clamp(segment_closest_t(px, py, a.x, a.y, b.x, b.y), 0.0, 1.0);
            float cx = a.x + (b.x - a.x) * t;
            float cy = a.y + (b.y - a.y) * t;
            float dx = px - cx;
            float dy = py - cy;
            float dist = sqrt(dx * dx + dy * dy);
            if (dist < best_dist) {
                best_dist = dist;
                best_width = a.width + (b.width - a.width) * t;
            }
        }
    }
    return vec2(best_dist, best_width);
}

// Apply river carving to a single voxel. Returns the new material, or
// 0xFFFFFFFFu if no river override applies. Mirrors Rust
// carve_river_in_chunk per-voxel logic (no state between voxels).
uint river_override(int vx, int vy, int vz, uint base_mat, uint seed) {
    // Never carve Granite.
    if (base_mat == MAT_GRANITE) return 0xFFFFFFFFu;

    vec2 rd = closest_river_distance(float(vx), float(vy));
    float dist = rd.x;
    float width = rd.y;
    if (dist >= width) return 0xFFFFFFFFu;

    int surface_z_river = surface_height_at(float(vx), float(vy), seed);
    int bed_depth = max(int(width * 0.3), 2);
    int river_surface_z = surface_z_river;
    int river_bed_z = river_surface_z - bed_depth;
    float dist_ratio = dist / width;

    if (dist_ratio < 0.4) {
        // Center channel
        if (vz <= river_surface_z && vz >= river_bed_z) {
            int midpoint = (river_bed_z + river_surface_z) / 2;
            return (vz <= midpoint) ? MAT_WATER : MAT_AIR;
        } else if (vz > river_surface_z && vz <= river_surface_z + 1) {
            // One voxel above surface: carve open top if base is solid.
            // is_solid is false for Air, Water, Lava — mirror the Rust check.
            if (base_mat != MAT_AIR && base_mat != MAT_WATER && base_mat != MAT_LAVA) {
                return MAT_AIR;
            }
        }
    } else if (dist_ratio < 0.7) {
        // Bank zone — gradual slope: carve top few voxels to Air.
        float bank_t = (dist_ratio - 0.4) / 0.3;
        int carve_depth = int((1.0 - bank_t) * float(bed_depth) * 0.5);
        int bank_top = river_surface_z;
        int bank_bot = river_surface_z - carve_depth;
        if (vz <= bank_top && vz >= bank_bot) {
            if (base_mat != MAT_AIR && base_mat != MAT_WATER && base_mat != MAT_LAVA) {
                return MAT_AIR;
            }
        }
    }
    return 0xFFFFFFFFu;
}

// ---------------------------------------------------------------------------
// Surface features — mirrors Rust terrain/features.rs.
// ---------------------------------------------------------------------------
//
// The CPU iterates every column in the chunk, runs a per-column density hash,
// and if it passes, stamps a tree/boulder/pillar shape with bounds-clipping to
// the chunk. On GPU we reverse this: for each voxel we iterate the chunk's
// columns, run the same density check, and test if the voxel falls inside
// the feature's footprint. Very expensive (O(voxels * columns)) but bounded
// by aggressive early-outs on the voxel's distance from the surface and from
// each column (dx² + dy² vs max feature footprint radius).

// Material ids referenced by features.
const uint MAT_WOOD_LOG = 17u;

// Salt constants as uvec2(lo, hi) matching Rust u64 values.
// e.g. 0x7777_1234_0001 = (lo=0x12340001, hi=0x00007777).
const uvec2 SALT_TREE_DENSITY    = uvec2(0x00007777u, 0x12340001u);
const uvec2 SALT_TREE_HEIGHT     = uvec2(0x0000AAAAu, 0x12340002u);
const uvec2 SALT_BOULDER_DENSITY = uvec2(0x0000CCCCu, 0x56780001u);
const uvec2 SALT_BOULDER_SIZE    = uvec2(0x0000DDDDu, 0x56780002u);
const uvec2 SALT_PILLAR_DENSITY  = uvec2(0x0000EEEEu, 0x56780003u);
const uvec2 SALT_PILLAR_HEIGHT   = uvec2(0x0000FFFFu, 0x56780004u);

// Add a u32 seed (widened to u64) to a u64 salt. Returns uvec2(hi, lo).
uvec2 seed_plus_salt(uint seed, uvec2 salt) {
    return u64_add(widen_seed(seed), salt);
}

// Maximum footprint radii (must conservatively bound the largest shape).
// Procedural trees: crown_radius_xy up to 30 + leaf_radius ~10.5 + slack ≈ 44
// max horizontal reach from origin. dx²+dy² up to ~44² = 1936.
// Vertical: trunk up to 120 + crown_height up to ~80 + leaf_radius ~10 ≈ 220.
// Droopy willows extend ~44 below the base.
const int FEATURE_MAX_RADIUS_SQ = 2025; // 45²
const int FEATURE_MAX_Z_ABOVE   = 220;  // head-room above surface
const int FEATURE_MAX_Z_BELOW   = 45;   // droopy crown can extend below base

struct FeatureParams {
    float tree_density;
    float boulder_density;
    float pillar_density;
    uint  pillar_material;
    uint  canopy_material;
};

FeatureParams feature_params(uint terrain, uint sub_biome) {
    FeatureParams p;
    p.tree_density = 0.0;
    p.boulder_density = 0.0;
    p.pillar_density = 0.0;
    p.pillar_material = 2u;   // Stone
    p.canopy_material = 42u;  // Leaves (default)

    // Tree density per biome (matches Rust feature_params).
    if (terrain == 1u) { // Forest
        if (sub_biome == SUB_DENSE_FOREST)   p.tree_density = 0.004;
        else if (sub_biome == SUB_LIGHT_FOREST) p.tree_density = 0.001;
        else if (sub_biome == SUB_ANCIENT_FOREST) p.tree_density = 0.002;
        else p.tree_density = 0.002;
    } else if (terrain == 9u) { // Jungle
        if (sub_biome == SUB_TEMPLE_JUNGLE) p.tree_density = 0.005;
        else p.tree_density = 0.006;
    } else if (terrain == 6u) { p.tree_density = 0.0005; } // Tundra
    else if (terrain == 4u) { p.tree_density = 0.002; }    // Swamp
    else if (terrain == 2u) { p.tree_density = 0.0003; }   // Mountains
    else if (terrain == 0u) { p.tree_density = 0.0003; }   // Plains

    // Boulder density.
    if (terrain == 0u)       p.boulder_density = 0.01;   // Plains
    else if (terrain == 5u)  p.boulder_density = 0.02;   // Desert
    else if (terrain == 12u) p.boulder_density = 0.02;   // Badlands
    else if (terrain == 6u)  p.boulder_density = 0.008;  // Tundra
    else if (terrain == 2u)  p.boulder_density = 0.02;   // Mountains

    // Pillar density + material.
    if (terrain == 5u) {
        p.pillar_density = 0.008;
        p.pillar_material = 27u; // Sandstone
    } else if (terrain == 12u) {
        p.pillar_density = 0.012;
        p.pillar_material = 39u; // RedSand
    }

    // Canopy material per biome.
    if (terrain == 9u)      p.canopy_material = 37u; // Jungle → JungleMoss
    else if (terrain == 4u) p.canopy_material = 42u; // Swamp → Leaves
    else                    p.canopy_material = 42u; // Default → Leaves

    return p;
}

// ---------- Procedural tree parameters (mirrors Rust features.rs) ----------

const uint SHAPE_ELLIPSOID = 0u;
const uint SHAPE_CONE      = 1u;
const uint SHAPE_FLAT_WIDE = 2u;
const uint SHAPE_DROOPY    = 3u;

struct TreeParams {
    int   trunk_height;
    float trunk_radius;
    int   crown_base_z;
    int   crown_height;
    float crown_radius_xy;
    float crown_radius_z;
    uint  crown_shape;
    uint  num_attractors;
    uint  num_clusters;
    float branch_radius;
    float leaf_radius;
    uint  canopy_material;
};

// Mirrors Rust tree_params_for_biome. Uses u64 hash path with TREE_HEIGHT_SALT.
TreeParams tree_params_for_biome(uint terrain, int ox, int oy, uint seed) {
    uvec2 s = seed_plus_salt(seed, SALT_TREE_HEIGHT);
    float size_hash = hash_f32_u64_full(ox, oy, 5, s);
    float h_hash    = hash_f32_u64_full(ox, oy, 0, s);

    int   trunk_height;
    float trunk_radius;
    float crown_radius_xy;
    if (size_hash < 0.2) {
        trunk_height    = 10 + int(h_hash * 10.0);
        trunk_radius    = 1.0;
        crown_radius_xy = 5.0 + h_hash * 3.0;
    } else if (size_hash > 0.8) {
        trunk_height    = 80 + int(h_hash * 40.0);
        trunk_radius    = 2.0 + h_hash;
        crown_radius_xy = 20.0 + h_hash * 10.0;
    } else {
        trunk_height    = 40 + int(h_hash * 30.0);
        trunk_radius    = 1.0 + h_hash * 1.5;
        crown_radius_xy = 12.0 + h_hash * 6.0;
    }

    uint  crown_shape;
    uint  num_attractors;
    uint  num_clusters;
    float crown_stretch_z;
    if (terrain == 6u) {        // Tundra
        crown_shape = SHAPE_CONE;      num_attractors = 10u; num_clusters = 4u; crown_stretch_z = 1.3;
    } else if (terrain == 0u) { // Plains
        crown_shape = SHAPE_FLAT_WIDE; num_attractors = 12u; num_clusters = 4u; crown_stretch_z = 0.5;
    } else if (terrain == 9u) { // Jungle
        crown_shape = SHAPE_CONE;      num_attractors = 20u; num_clusters = 6u; crown_stretch_z = 1.2;
    } else if (terrain == 4u) { // Swamp
        crown_shape = SHAPE_DROOPY;    num_attractors = 14u; num_clusters = 5u; crown_stretch_z = 1.0;
    } else {                    // Forest default
        crown_shape = SHAPE_ELLIPSOID; num_attractors = 16u; num_clusters = 5u; crown_stretch_z = 0.9;
    }

    TreeParams tp;
    tp.trunk_height    = trunk_height;
    tp.trunk_radius    = trunk_radius;
    tp.crown_base_z    = int(float(trunk_height) * 0.55);
    tp.crown_height    = int(crown_radius_xy * 2.0 * crown_stretch_z);
    tp.crown_radius_xy = crown_radius_xy;
    tp.crown_radius_z  = crown_radius_xy * crown_stretch_z;
    tp.crown_shape     = crown_shape;
    tp.num_attractors  = num_attractors;
    tp.num_clusters    = num_clusters;
    tp.branch_radius   = max(trunk_radius * 0.4, 0.7);
    tp.leaf_radius     = max(crown_radius_xy * 0.35, 1.5);
    tp.canopy_material = (terrain == 9u) ? 37u /*JungleMoss*/ : 42u /*Leaves*/;
    return tp;
}

// Mirrors Rust attractor(). Uses seed.wrapping_add(0xA77A) as the u64 base.
// 0xA77A fits in the low 32 bits; the salt has hi=0.
const uvec2 SALT_TREE_ATTR = uvec2(0x00000000u, 0x0000A77Au);

vec3 tree_attractor(uint i, int ox, int oy, uint seed, TreeParams tp) {
    uvec2 s = seed_plus_salt(seed, SALT_TREE_ATTR);
    int iz1 = int(i) * 7 + 1;
    int iz2 = int(i) * 7 + 2;
    int iz3 = int(i) * 7 + 3;
    float h1 = hash_f32_u64_full(ox, oy, iz1, s);
    float h2 = hash_f32_u64_full(ox, oy, iz2, s);
    float h3 = hash_f32_u64_full(ox, oy, iz3, s);

    float angle = h1 * 2.0 * 3.14159265358979323846;
    float t_z = h3;

    float radius_factor;
    if (tp.crown_shape == SHAPE_ELLIPSOID || tp.crown_shape == SHAPE_FLAT_WIDE) {
        float z_norm = 2.0 * t_z - 1.0;
        radius_factor = sqrt(max(1.0 - z_norm * z_norm, 0.0));
    } else if (tp.crown_shape == SHAPE_CONE) {
        radius_factor = 1.0 - t_z;
    } else { // SHAPE_DROOPY
        radius_factor = (t_z < 0.3) ? 1.0 : (1.0 - (t_z - 0.3) / 0.7);
    }

    float radius = sqrt(h2) * tp.crown_radius_xy * radius_factor;
    float dx = cos(angle) * radius;
    float dy = sin(angle) * radius;

    float dz;
    if (tp.crown_shape == SHAPE_DROOPY) {
        dz = float(tp.crown_base_z) + (t_z - 0.3) * float(tp.crown_height);
    } else {
        dz = float(tp.crown_base_z) + t_z * float(tp.crown_height);
    }
    return vec3(dx, dy, dz);
}

// Capsule SDF (signed distance). Negative inside.
float capsule_sdf(vec3 p, vec3 a, vec3 b, float r) {
    vec3 ab = b - a;
    vec3 ap = p - a;
    float ab2 = dot(ab, ab);
    float t = (ab2 > 1e-6) ? clamp(dot(ap, ab) / ab2, 0.0, 1.0) : 0.0;
    vec3 c = a + ab * t - p;
    return length(c) - r;
}

float sphere_sdf(vec3 p, vec3 c, float r) {
    return length(p - c) - r;
}

// Try to place a tree at origin (ox,oy) and test whether it covers (vx,vy,vz).
// Returns the override material or 0xFFFFFFFFu if not covered.
// `covered_by_trunk` out-param flags whether the covered voxel is a trunk or
// branch voxel (used by leaves to skip overwriting the trunk).
uint try_tree_at(int ox, int oy, int vx, int vy, int vz, int feature_base_z,
                 uint seed, FeatureParams fp, uint terrain, out bool covered_by_trunk) {
    covered_by_trunk = false;

    // Density check — same path as before.
    float td = hash_f32_u64_full(ox, oy, 0, seed_plus_salt(seed, SALT_TREE_DENSITY));
    float cluster = fbm_2d(float(ox) * 0.025, float(oy) * 0.025,
                           seed + 0xC1C1u, 2, 2.0, 0.5);
    float effective_density = fp.tree_density * (0.3 + cluster * 1.4);
    if (td >= effective_density) return 0xFFFFFFFFu;

    TreeParams tp = tree_params_for_biome(terrain, ox, oy, seed);

    vec3 p = vec3(float(vx), float(vy), float(vz));
    vec3 origin_base = vec3(float(ox), float(oy), float(feature_base_z));

    // Trunk capsule.
    vec3 trunk_a = origin_base;
    vec3 trunk_b = origin_base + vec3(0.0, 0.0, float(tp.trunk_height));
    float trunk_d = capsule_sdf(p, trunk_a, trunk_b, tp.trunk_radius);
    if (trunk_d <= 0.0) {
        covered_by_trunk = true;
        return MAT_WOOD_LOG;
    }

    // Compute cluster centroids and branch capsules.
    // Each attractor is assigned to cluster (i % num_clusters). We stream
    // through attractors twice: once to compute centroids, once to test
    // leaf spheres. This matches the Rust reference implementation.
    float min_branch = 1e9;
    for (uint ci = 0u; ci < tp.num_clusters; ci++) {
        vec3 sum = vec3(0.0);
        uint cnt = 0u;
        for (uint j = 0u; j < tp.num_attractors; j++) {
            if ((j % tp.num_clusters) != ci) continue;
            sum += tree_attractor(j, ox, oy, seed, tp);
            cnt++;
        }
        vec3 ctd = (cnt > 0u) ? (sum / float(cnt)) : vec3(0.0);

        float t_along = (float(ci) / float(tp.num_clusters)) * 0.4 + 0.55;
        vec3 branch_a = origin_base + vec3(0.0, 0.0, float(tp.trunk_height) * t_along);
        vec3 branch_b = origin_base + ctd;
        float d = capsule_sdf(p, branch_a, branch_b, tp.branch_radius);
        if (d < min_branch) min_branch = d;
    }
    if (min_branch <= 0.0) {
        covered_by_trunk = true;
        return MAT_WOOD_LOG;
    }

    // Leaf spheres.
    for (uint i = 0u; i < tp.num_attractors; i++) {
        vec3 attr = tree_attractor(i, ox, oy, seed, tp);
        vec3 leaf_c = origin_base + attr;
        if (sphere_sdf(p, leaf_c, tp.leaf_radius) <= 0.0) {
            return tp.canopy_material;
        }
    }

    return 0xFFFFFFFFu;
}

// Boulder: axis-aligned cube of Stone with origin at (ox,oy,feature_base_z),
// extents size×size×size forward in +x,+y,+z.
uint try_boulder_at(int ox, int oy, int vx, int vy, int vz, int feature_base_z,
                    uint seed, FeatureParams fp) {
    float bd = hash_f32_u64_full(ox, oy, 0, seed_plus_salt(seed, SALT_BOULDER_DENSITY));
    if (bd >= fp.boulder_density) return 0xFFFFFFFFu;

    float s_hash = hash_f32_u64_full(ox, oy, 2, seed_plus_salt(seed, SALT_BOULDER_SIZE));
    int size = 3 + int(s_hash * 8.0);

    int dx = vx - ox;
    int dy = vy - oy;
    int dz = vz - feature_base_z;
    if (dx >= 0 && dx < size && dy >= 0 && dy < size && dz >= 0 && dz < size) {
        return 2u; // Stone
    }
    return 0xFFFFFFFFu;
}

// Pillar: cylindrical column centered at (ox,oy), base at feature_base_z,
// height and radius hashed from PILLAR_HEIGHT_SALT.
uint try_pillar_at(int ox, int oy, int vx, int vy, int vz, int feature_base_z,
                   uint seed, FeatureParams fp) {
    float pd = hash_f32_u64_full(ox, oy, 0, seed_plus_salt(seed, SALT_PILLAR_DENSITY));
    if (pd >= fp.pillar_density) return 0xFFFFFFFFu;

    float h_hash = hash_f32_u64_full(ox, oy, 3, seed_plus_salt(seed, SALT_PILLAR_HEIGHT));
    int height = 20 + int(h_hash * 40.0);
    int radius = 3 + int(h_hash * 3.0);

    int dx = vx - ox;
    int dy = vy - oy;
    int dz = vz - feature_base_z;
    if (dz < 0 || dz >= height) return 0xFFFFFFFFu;
    int r2 = radius * radius + 1;
    if (dx * dx + dy * dy > r2) return 0xFFFFFFFFu;
    return fp.pillar_material;
}

// Apply surface feature overrides for (vx,vy,vz) by scanning origin columns
// in a halo around this chunk. Each origin samples its own biome (matches
// CPU halo stamping in features.rs::place_surface_features).
uint apply_features(int vx, int vy, int vz, uint base_mat, uint seed) {
    int cs = int(pc.params.y);
    int base_x = pc.chunk_pos.x * cs;
    int base_y = pc.chunk_pos.y * cs;
    int base_z = pc.chunk_pos.z * cs;

    // Early-out: skip voxels far from this voxel's own surface. Features sit
    // 1 voxel above the per-column surface with max vertical reach ~160.
    int my_surface_z = surface_height_at(float(vx), float(vy), seed);
    if (vz < my_surface_z - FEATURE_MAX_Z_BELOW || vz > my_surface_z + FEATURE_MAX_Z_ABOVE) {
        return base_mat;
    }

    // Scan a halo around this voxel for origin columns whose feature
    // footprint could reach (vx,vy,vz). No clipping to chunk bounds — origin
    // columns in neighbor chunks contribute trunk/canopy voxels that cross
    // into this chunk.
    int vlx = vx - base_x;
    int vly = vy - base_y;
    int rmax = 45; // max procedural tree horizontal reach
    int olx_min = vlx - rmax;
    int olx_max = vlx + rmax;
    int oly_min = vly - rmax;
    int oly_max = vly + rmax;

    uint mat = base_mat;
    bool mat_is_trunk = false; // track if current mat came from a trunk voxel

    for (int oly = oly_min; oly <= oly_max; oly++) {
        for (int olx = olx_min; olx <= olx_max; olx++) {
            int ox = base_x + olx;
            int oy = base_y + oly;

            int dx = vx - ox;
            int dy = vy - oy;
            int d2 = dx * dx + dy * dy;
            if (d2 > FEATURE_MAX_RADIUS_SQ) continue;

            // Sample cell AT this origin — the origin may be in a neighbor
            // chunk with a different biome (matches CPU per-origin sampling).
            RegionCell origin_cell = sample_cell(float(ox), float(oy));
            FeatureParams fp = feature_params(origin_cell.terrain, origin_cell.sub_biome);
            if (fp.tree_density == 0.0 && fp.boulder_density == 0.0 && fp.pillar_density == 0.0) continue;

            // Per-column surface (expensive FBM call).
            int col_surface_z = surface_height_at(float(ox), float(oy), seed);
            int feature_base_z = col_surface_z + 1;

            // Early-out: if the feature's vertical extent can't reach this
            // chunk, skip. No local_z clip — feature may span multiple chunks.
            if (feature_base_z + FEATURE_MAX_Z_ABOVE < base_z ||
                feature_base_z - 1 >= base_z + cs) continue;

            // Trees first (CPU order).
            if (fp.tree_density > 0.0) {
                bool trunk_hit;
                uint tm = try_tree_at(ox, oy, vx, vy, vz, feature_base_z, seed, fp, origin_cell.terrain, trunk_hit);
                if (tm != 0xFFFFFFFFu) {
                    // CPU canopy rule: canopy does NOT overwrite trunk voxels.
                    // On GPU, if a previous iteration marked us as a trunk and
                    // this iteration is a canopy hit, skip the overwrite.
                    if (!trunk_hit && mat_is_trunk) {
                        // keep trunk
                    } else {
                        mat = tm;
                        mat_is_trunk = trunk_hit;
                    }
                }
            }

            // Boulder (CPU writes unconditionally — no skip for tree columns
            // since CPU feature.rs doesn't track per-column state either).
            if (fp.boulder_density > 0.0) {
                uint bm = try_boulder_at(ox, oy, vx, vy, vz, feature_base_z, seed, fp);
                if (bm != 0xFFFFFFFFu) {
                    mat = bm;
                    mat_is_trunk = false;
                }
            }

            // Pillar.
            if (fp.pillar_density > 0.0) {
                uint pm = try_pillar_at(ox, oy, vx, vy, vz, feature_base_z, seed, fp);
                if (pm != 0xFFFFFFFFu) {
                    mat = pm;
                    mat_is_trunk = false;
                }
            }
        }
    }

    return mat;
}

uint material_at(int vx, int vy, int vz, uint seed) {
    RegionCell cell = sample_cell(float(vx), float(vy));
    uint terrain = cell.terrain;

    int surface_z = surface_height_at(float(vx), float(vy), seed);
    int depth = surface_z - vz;

    uvec3 mats = surface_materials(terrain);

    // Ore boost for mountains/caverns.
    float ore_boost = 0.0;
    if (terrain == 2u || terrain == 11u) ore_boost = 0.03;

    // Layer assignment — mirrors Rust materialize.rs:114-250.
    if (vz < -500) {
        return 3u; // Granite (deep bedrock)
    }
    if (depth > 80) {
        // Deep stone zone — ore veins possible.
        uint ore = ore_at(vx, vy, vz, seed, ore_boost);
        if (ore != 0u) return ore;
        return mats.z; // deep_stone
    }
    if (depth > 20) {
        // Subsoil zone.
        if (terrain == 2u || terrain == 10u) {
            // Mountains/Glacier: geological banding on cliff faces.
            float band = sin(float(vz) * 0.15) * 0.5 + 0.5;
            float n = hash_f32_u64(vx, vy, vz, seed + 0x1234u);
            if (band > 0.75) return 3u;           // Granite
            if (band > 0.5 && n > 0.3) return 6u; // Gravel
            return 2u;                            // Stone
        } else {
            float n = hash_f32_u64(vx, vy, vz, seed + 0x1234u);
            if (n > 0.4) return mats.z; // deep_stone
            return mats.y;              // subsoil
        }
    }
    if (depth > 0) {
        // Near-surface soil.
        if (terrain == 12u) {
            // Badlands: layered sediment.
            float band = sin(float(vz) * 0.3) * 0.5 + 0.5;
            if (band > 0.7) return 5u;  // Clay
            if (band > 0.4) return 27u; // Sandstone
            return 39u;                 // RedSand
        }
        return mats.y; // subsoil
    }
    if (depth >= -1) {
        // Surface layer (depth 0 or -1).
        if (terrain == 2u || terrain == 10u) {
            // Mountain surface: snow line + gravel patches.
            float n = hash_f32_u64(vx, vy, vz, seed + 0xA1B2u);
            if (vz > 750) return 11u; // Snow
            if (vz > 600) {
                float snow_prob = float(vz - 600) / 150.0;
                if (n < snow_prob) return 11u; // Snow
                if (n > 0.8) return 6u;        // Gravel
                return 2u;                     // Stone
            }
            if (n > 0.7) return 6u; // Gravel
            return 2u;              // Stone
        }
        if (terrain == 9u) {
            // Jungle floor: undergrowth.
            float pat = fbm_2d(float(vx) * 0.06, float(vy) * 0.06, seed + 0xBEAFu, 2, 2.0, 0.5);
            float n = hash_f32_u64(vx, vy, vz, seed + 0xD00u);
            if (pat > 0.65) return 5u;  // Clay (mud)
            if (n > 0.9) return 17u;    // WoodLog (fallen branch)
            if (n > 0.8) return 1u;     // Dirt
            return 37u;                 // JungleMoss
        }
        if (terrain == 5u) {
            // Desert: dune ridges.
            float angle = 0.7;
            float rx = float(vx) * cos(angle) + float(vy) * sin(angle);
            float dune = sin(rx * 0.08) * 0.5 + 0.5;
            float n = hash_f32_u64(vx, vy, vz, seed + 0xD0E5u);
            if (dune > 0.7) return 27u; // Sandstone (dune crest)
            if (n > 0.9) return 6u;     // Gravel
            return 4u;                  // Sand
        }
        if (terrain == 1u) {
            // Forest floor: subtle leaf litter.
            float pat = fbm_2d(float(vx) * 0.04, float(vy) * 0.04, seed + 0xF0E5u, 2, 2.0, 0.5);
            float n = hash_f32_u64(vx, vy, vz, seed + 0xF100u);
            if (pat > 0.78) return 40u; // Peat (leaf litter)
            if (n > 0.95) return 17u;   // WoodLog (rare fallen branch)
            return 7u;                  // Grass
        }
        if (terrain == 0u) {
            // Plains: TallGrass with darker grass patches.
            float pat = fbm_2d(float(vx) * 0.04, float(vy) * 0.04, seed + 0xF1E1Du, 2, 2.0, 0.5);
            if (pat > 0.6) return 7u; // Grass
            return 41u;               // TallGrass
        }
        if (terrain == 12u) {
            // Badlands: layered sediment on surface.
            float band = sin(float(vz) * 0.3) * 0.5 + 0.5;
            float n = hash_f32_u64(vx, vy, vz, seed + 0xBAD1u);
            if (band > 0.7) return 27u;           // Sandstone
            if (band > 0.4 && n > 0.5) return 5u; // Clay
            return 39u;                           // RedSand
        }
        if (terrain == 6u) {
            // Tundra: patchy snow over peat.
            float n = hash_f32_u64(vx, vy, vz, seed + 0xC01Du);
            float pat = fbm_2d(float(vx) * 0.015, float(vy) * 0.015, seed + 0xF02u, 3, 2.0, 0.5);
            if (pat > 0.68) return 11u;           // Snow
            if (pat > 0.6 && n > 0.6) return 10u; // Ice
            if (n > 0.85) return 6u;              // Gravel
            return 40u;                           // Peat
        }
        return mats.x; // default surface
    }
    // Above surface.
    if (vz <= SEA_LEVEL && (terrain == 8u || terrain == 3u || terrain == 16u || terrain == 4u)) {
        // DeepOcean / Coast / CoralReef / Swamp below sea level → water.
        return 8u; // Water
    }
    return 0u; // Air
}

// Compute chunk-level cave params (matches Rust materialize.rs:297-309).
// Returns vec4(0,0,0,0) if no carving applies to this chunk. Computed once
// per workgroup-local invocation using chunk-center coordinates so all
// voxels within the chunk share the same params (mirrors CPU behaviour).
vec4 chunk_cave_params(int cs, uint seed) {
    int base_x = pc.chunk_pos.x * cs;
    int base_y = pc.chunk_pos.y * cs;
    int base_z = pc.chunk_pos.z * cs;
    int cx = base_x + cs / 2;
    int cy = base_y + cs / 2;
    int cz = base_z + cs / 2;

    RegionCell cell = sample_cell(float(cx), float(cy));
    int surface_z = surface_height_at(float(cx), float(cy), seed);
    int depth_below = surface_z - cz;

    if (depth_below <= 20) return vec4(0.0);
    uint underground = resolve_underground_biome(cell.terrain, depth_below);
    return cave_params(underground);
}

void main() {
    uint cs = pc.params.y;

    uvec3 lp = gl_GlobalInvocationID;
    if (lp.x >= cs || lp.y >= cs || lp.z >= cs) return;

    uint seed = pc.params.x;
    int vx = pc.chunk_pos.x * int(cs) + int(lp.x);
    int vy = pc.chunk_pos.y * int(cs) + int(lp.y);
    int vz = pc.chunk_pos.z * int(cs) + int(lp.z);

    uint mat = material_at(vx, vy, vz, seed);

    // Cave carving post-pass — chunk-level biome resolved once.
    vec4 cparams = chunk_cave_params(int(cs), seed);
    if (cparams.y > 0.0) {
        int lz_i = int(lp.z);
        uint o = cave_override(vx, vy, vz, lz_i, mat, seed, cparams);
        if (o != 0xFFFFFFFFu) mat = o;
    }

    // River carving post-pass — runs AFTER caves so caves take priority
    // underground. Iterates all uploaded river polylines per voxel.
    {
        uint r = river_override(vx, vy, vz, mat, seed);
        if (r != 0xFFFFFFFFu) mat = r;
    }

    // Surface features post-pass — trees, boulders, pillars. Must run after
    // caves and rivers to match CPU order. Very expensive (per-voxel column
    // scan); relies on early-outs in apply_features to stay tractable.
    mat = apply_features(vx, vy, vz, mat, seed);

    // NOTE: storage layout is engine-oriented (x, y-up, z) to match what the
    // renderer's gbuffer raycaster expects. The compute thread lp is in sim
    // local coords where lp.z is the vertical axis, so we swap Y↔Z on store.
    // Readback consumers (parity tests, sync generate_chunk) must apply the
    // same swap when indexing the returned bytes.
    imageStore(out_image, ivec3(int(lp.x), int(lp.z), int(lp.y)), uvec4(mat, 0u, 0u, 0u));
}
