#version 450
layout(local_size_x = 64) in;

struct Body {
    vec4 pos_mass;
    vec4 orient;
    vec4 lin_vel;
    vec4 ang_vel;
    vec4 old_pos;
    vec4 pad0;
};

layout(set = 0, binding = 0) buffer Bodies {
    Body bodies[];
} body_buf;

layout(set = 0, binding = 1) buffer Params {
    float dt;
    float gravity;
    uint num_bodies;
    float damping;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.num_bodies) return;

    Body b = body_buf.bodies[idx];
    if (b.pos_mass.w <= 0.0) return;

    // Derive velocity from position change
    float inv_dt = 1.0 / max(params.dt, 1e-8);
    b.lin_vel.xyz = (b.pos_mass.xyz - b.old_pos.xyz) * inv_dt;

    // Damping
    b.lin_vel.xyz *= params.damping;

    body_buf.bodies[idx] = b;
}
